{
  "name": "mo-codemirror-bundle",
  "private": true,
  "description": "Builds internal/web/static/vendor/codemirror.js. Only needed when bumping versions: `make codemirror`.",
  "scripts": {
    "build": "esbuild entry.js --bundle --minify --format=iife --global-name=CM --target=es2020 --legal-comments=eof --outfile=../../internal/web/static/vendor/codemirror.js"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.18.0",
    "@codemirror/commands": "^6.8.0",
    "@codemirror/lang-css": "^6.3.0",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-javascript": "^6.2.3",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/lang-markdown": "^6.3.2",
    "@codemirror/lang-python": "^6.1.7",
    "@codemirror/lang-sql": "^6.8.0",
    "@codemirror/lang-yaml": "^6.1.2",
    "@codemirror/language": "^6.11.0",
    "@codemirror/legacy-modes": "^6.5.1",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/search": "^6.5.10",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.0",
    "@lezer/highlight": "^1.2.1",
    "codemirror": "^6.0.2",
    "esbuild": "^0.28.2"
  }
}
