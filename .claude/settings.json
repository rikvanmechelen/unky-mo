{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",

      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git status*)",
      "Bash(git branch*)",
      "Bash(git show*)",
      "Bash(git blame*)",
      "Bash(git stash list*)",
      "Bash(git remote -v*)",
      "Bash(git ls-files*)",
      "Bash(git rev-parse*)",
      "Bash(git shortlog*)",
      "Bash(git tag --list*)",
      "Bash(git config --get*)",

      "Bash(go build*)",
      "Bash(go run*)",
      "Bash(go test*)",
      "Bash(go vet*)",
      "Bash(go mod*)",
      "Bash(go get*)",
      "Bash(go fmt*)",

      "Bash(make*)",

      "Bash(ls*)",
      "Bash(wc*)",
      "Bash(sort*)",
      "Bash(uniq*)",
      "Bash(head*)",
      "Bash(tail*)",
      "Bash(find*)",
      "Bash(cat*)",
      "Bash(tree*)",
      "Bash(which*)",
      "Bash(diff*)",
      "Bash(du*)",
      "Bash(mkdir*)",
      "Bash(rmdir*)",
      "Bash(chmod*)",
      "Bash(stat*)",
      "Bash(sleep*)",

      "Bash(tmux*)",

      "Bash(claude --help*)",
      "Bash(claude --version*)"
    ],
    "deny": [
      "Bash(rm -rf*)"
    ]
  },
  "enabledPlugins": {
    "commit-commands@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true
  }
}
